	<string name="info_affiliation_id">כאשר בעל המכשיר יוצר משתמש מנוהל, המשתמש המנוהל אינו משויך. כדי להפוך את המשתמש המנוהל למזוהה עם בעל המכשיר, עליך להגדיר את אותם מזהים משויכים במשתמש הראשי ובמשתמש המנוהל</string>
	<string name="info_always_on_vpn">הגדר חיבור VPN תמידי דרך יישום ספציפי עבור המשתמש הנוכחי. חיבור זה מוענק אוטומטית ונמשך לאחר אתחול מחדש.\nהפעל נעילה: אסור להתחבר לרשת כאשר ה-VPN אינו מחובר.</string>
	<string name="info_backup_service">לכל משתמש יש שירות גיבוי משלו המנהל את מנגנוני הגיבוי והשחזור באותו משתמש. השבתת שירות הגיבוי תמנע גיבוי או שחזור של נתונים.\nעבור משתמש מנוהל פונקציונליות הגיבוי שלו מופעלת רק אם גם בעל המכשיר וגם בעל הפרופיל הפעילו את שירות הגיבוי.</string>
	<string name="info_common_criteria_mode">כאשר המכשיר נמצא במצב Common Criteria, פונקציונליות מסויימת של המכשיר מכווננת כך שתעמוד ברמת האבטחה הגבוהה יותר הנדרשת על ידי אישור Common Criteria.</string>
	<string name="info_content_protection_policy">מדיניות הגנת תוכן שולטת בסריקה לאיתור אפליקציות מטעות.</string>
	<string name="info_cross_profile_intent_filter">הוסף מסנני כוונות חוצי פרופיל כך שחלק מהכוונות שנשלחות בפרופיל המנוהל יוכלו להיפתר גם בהורה, או להיפך. רק כוונות פעילות נתמכות.</string>
	<string name="info_deactivate">OwnDroid יאבד את הפריבילגיה שלו</string>
	<string name="info_device_id_attestation">מציין אם ההתקן תומך באישור של מזהי מכשיר בנוסף לאישור מפתח.</string>
	<string name="info_disable_account_management">כאשר ניהול חשבון מושבת עבור סוג חשבון, הוספה או הסרה של חשבון מסוג זה לא תתאפשר.</string>
	<string name="info_disable_keyguard">הגדרת מגן המקשים לבלתי פעיל משפיעה כמו בחירה ב-\'ללא\' כסוג נעילת המסך. עם זאת, להגדרה זו אין השפעה, אם סיסמה, PIN או תבנית מוגדרים כעת.\nאם סיסמה, PIN או תבנית מוגדרים לאחר שהמגן הושבת, מגן המקשים מפסיק להיות זמין.</string>
	<string name="info_disable_user_control">המשתמש לא יוכל לנקות את נתוני האפליקציה או להפסיק חבילות בכוח.</string>
	<string name="info_enable_system_app">הפעל מחדש אפליקציית מערכת שהושבתה כברירת מחדל כאשר המשתמש אותחל.</string>
	<string name="info_enrollment_specific_id">המזהה יהיה עקבי גם אם פרופיל העבודה יוסר וייצור שוב (לאותו מזהה ארגון), או שהמכשיר יאופס להגדרות היצרן ונרשם מחדש.</string>
	<string name="info_evict_credential_encryption_key">הוצא את מפתח ההצפנה של המשתמש ממחזיק המפתחות. יהיה צורך להזין שוב את האישור של המשתמש על מנת לגזור את מפתח ההצפנה של האישור שיישמר בחזרה במחזיק המפתחות לשימוש עתידי. על מנת לאבטח את נתוני המשתמש, המשתמש ייעצר ויופעל מחדש.</string>
	<string name="info_frp_policy">מדיניות ההגנה על איפוס היצרן קובעת אילו חשבונות יכולים לבטל את הנעילה של מכשיר שעבר איפוס לא מהימן להגדרות היצרן (אתחול מהיר או שחזור).\nכדי להפעיל תכונה זו, המכשיר חייב לתמוך בשירות חסימת נתונים מתמשך.\nהגנת איפוס היצרן מושבתת אם ביטול הנעילה של OEM מופעלת באפשרויות המפתחים.</string>
	<string name="info_headless_system_user_mode">מצב משתמש מערכת ללא ראש פירושו שמשתמש המערכת מפעיל שירותי מערכת וממשק משתמש כלשהו של המערכת, אך הוא אינו משויך לאף אדם אמיתי ויש ליצור משתמשים נוספים כדי להיות משויכים לאנשים אמיתיים.</string>
	<string name="info_install_existing_app">התקן חבילה קיימת שהותקנה במשתמש אחר, או נשמרה לאחר הסרת ההתקנה.</string>
	<string name="info_keep_uninstalled_apps">הגדר רשימה של אפליקציות לשמירה כחבילות APK גם אם אף משתמש לא התקין אותה כעת.</string>
	<string name="info_lock_screen_info">הצג הודעה קצרה על מסך הנעילה שלך.\nעוקף כל מידע בעלים שהוגדר ידנית על ידי המשתמש ומונע מהמשתמש לשנות אותו.</string>
	<string name="info_lock_task_nav_buttons">מאפשר ללחצני הניווט לצאת ממצב נעילת המשימה. לחצן הבית תמיד יוצא ממצב נעילת המשימה וחוזר למשגר — ללא צורך בנגישות. אם שירות הנגישות של OwnDroid מופעל, גם חזרה ואחרונים יעבדו: בניווט שלושה-לחצנים אזורי המגע נשארים שקופים ומונחים מעל לחצני המערכת האמיתיים; בניווט מחוות מוצג סרגל לחצנים גלוי בתחתית.</string>
	<string name="lock_task_nav_accessibility_hint">לחצן הבית יעבוד גם בלי נגישות. הפעל את שירות הנגישות של OwnDroid כדי שגם חזרה ואחרונים יעבדו.</string>
	<string name="info_lock_task_packages">ניתן להפעיל רק חבילות ברשימת חבילות משימות נעילה במצב משימות נעילה.</string>
	<string name="info_lock_task_profile_shortcut">שומר את הבחירה הנוכחית (כולל האפליקציות המורשות והתכונות הנוכחיות) כפרופיל ויוצר קיצור דרך במסך הבית שמפעיל אותה במצב נעילת משימה.</string>
	<string name="info_lock_task_profiles">פרופיל שומר תצורת נעילת משימה: האפליקציה שתופעל, האפליקציות המורשות ותכונות נעילת המשימה. הפעלת פרופיל או לחיצה על קיצור הדרך שלו מחילה את התצורה השמורה ומפעילה את האפליקציה הראשית שלו במצב נעילת משימה.</string>
	<string name="info_lock_task_suspended_hidden">ניתן להוסיף גם אפליקציות שהושעו או הוסתרו על ידי OwnDroid. ההשעיה / ההסתרה שלהן תבוטל באופן זמני בזמן שמצב נעילת המשימה פעיל, והמצב הקודם שלהן ישוחזר מיד עם היציאה ממנו.</string>
	<string name="info_lockdown_admin_configured_network">שליטה אם המשתמש יכול לשנות רשתות שהוגדרו על ידי המנהל.\nכאשר הנעילה הזו מופעלת, המשתמש עדיין יכול להגדיר ולהתחבר לרשתות Wi-Fi אחרות, או להשתמש ביכולות Wi-Fi אחרות כגון שיתוף אינטרנט בין ניידים.</string>
	<string name="info_logout">אם המשתמש הנוכחי לא הוחלף על ידי OwnDroid, לא ניתן להשתמש בפונקציה זו.</string>
	<string name="info_long_support_message">זה יוצג למשתמש במסך הגדרות מנהלי המכשיר. אם ההודעה ארוכה מ-20000 תווים היא עשויה להיקטע.</string>
	<string name="info_max_failed_password_other_user">הגדרת זה לערך גדול מאפס מאפשרת מדיניות שתמחק את המשתמש הזה לאחר שהוזנו יותר מדי סיסמאות נעילה שגויות.</string>
	<string name="info_max_failed_password_system_user">הגדרה זו לערך גדול מאפס מאפשרת מדיניות לפיה המכשיר יאופס להגדרות היצרן לאחר שהוזנו יותר מדי סיסמאות שגויות לביטול נעילת המכשיר.</string>
	<string name="info_minimum_wifi_security_level">ציין את רמת האבטחה המינימלית הנדרשת עבור רשתות Wi-Fi. ייתכן שהמכשיר לא יתחבר לרשתות שאינן עומדות ברמת האבטחה המינימלית. אם הרשת הנוכחית לא עומדת ברמת האבטחה המינימלית שנקבעה, היא תתנתק.</string>
	<string name="info_mte_policy">הגדר את מדיניות הרחבת תיוג זיכרון. הפעל מחדש את המכשיר כדי להחיל שינויים.</string>
	<string name="info_nearby_app_streaming_policy">הזרמת אפליקציה היא כאשר המכשיר מפעיל אפליקציה בתצוגה וירטואלית ושולח זרם וידאו של האפליקציה למכשירים קרובים.</string>
	<string name="info_nearby_notification_streaming_policy">הזרמת הודעות היא שליחת נתוני הודעות מיישומים שהותקנו מראש למכשירים קרובים.</string>
	<string name="info_network_log">יומני רשת מכילים אירועי חיפוש DNS ו-connect() של קריאת שיחות.\nשימוש בפונקציה זו בפרופיל העבודה יאחזר רק יומני רשת בפרופיל העבודה.\nלא אמור להיות משתמש לא מזוהה במכשיר הזה אם משתמשים בו על ידי בעל המכשיר.</string>
	<string name="info_org_id">מגדיר את מזהה הארגון. זוהי דרישה ליצירת מזהה ספציפי לרישום עבור המכשיר. ניתן להגדיר את המזהה פעם אחת בלבד.</string>
	<string name="info_password_complexity">אין: אין סיסמה\nנמוך: דפוס, PIN (עם רצפים חוזרים או מסודרים)\nבינוני: PIN (ללא רצפים חוזרים או מסודרים, אורך 4 לפחות), אלפביתי (אורך 4 לפחות), אלפאנומרי (אורך 4 לפחות)\nגבוה: PIN (ללא רצפים חוזרים או מסודרים, אורך 8 לפחות), אלפביתי (אורך 6 לפחות), אלפאנומרי (אורך 6 לפחות)</string>
	<string name="info_password_expiration_timeout">הפעל מחדש את הספירה לאחור לפקיעת הסיסמה.\nערך 0 אומר שאין הגבלה.</string>
	<string name="info_password_history_length">לאחר הגדרה זו, המשתמש לא יוכל להזין סיסמה חדשה זהה לכל סיסמה בהיסטוריה. שימו לב שהסיסמה הנוכחית תישאר עד שהמשתמש יגדיר סיסמה חדשה, כך שהשינוי לא יתבצע באופן מיידי.\nערך 0 אומר שאין הגבלה.</string>
	<string name="info_permission_policy">הגדר את תגובת ברירת המחדל עבור בקשות עתידיות להרשאות זמן ריצה על ידי יישומים.</string>
	<string name="info_pre_reboot_security_log">לא כל המכשירים תומכים ביומני אבטחה לפני אתחול.</string>
	<string name="info_profile_maximum_time_off">הגדר את הזמן המרבי שהפרופיל מותר לכיבוי. אם הפרופיל כבוי למשך זמן רב יותר, אפליקציות אישיות מושעות במכשיר.\nהערך המינימלי שאינו אפס מתאים ל-72 שעות. אם מנהל מגדיר ערך קטן יותר שאינו אפס, במקום זאת יוגדרו 72 שעות.</string>
	<string name="info_reboot">לא ניתן להשתמש בפונקציה זו אם ישנה שיחה מתמשכת במכשיר.</string>
	<string name="info_recommended_global_proxy">פרוקסי זה הוא רק המלצה וייתכן שחלק מהאפליקציות יתעלמו ממנו.</string>
	<string name="info_required_strong_auth_timeout">קבע לכמה זמן המשתמש יוכל להשתמש באימות משני ולא חזק לאימות, מאז נעשה שימוש באימות השיטה החזקה האחרונה (סיסמה, סיכה או דפוס). לאחר פסק הזמן שהוחזר המשתמש נדרש להשתמש בשיטת אימות חזקה.\nערך של 0 פירושו שהמנהל אינו משתתף בשליטה בזמן הקצוב. הזמן הקצוב המינימלי והמקסימלי מוגדר על ידי הפלטפורמה והם בדרך כלל שעה ו-72 שעות, בהתאמה.</string>
	<string name="info_reset_password">הגדר סיסמת מסך נעילה חדשה. אורכה של סיסמה זו חייב להיות לפחות 4 ספרות. השאר אותו ריק כדי להסיר את הסיסמה.\nאם תגדיר סיסמה מספרית שאורכה הוא 6 ומטה, היא תוגדר כ-PIN</string>
	<string name="info_screen_timeout">הגדר את הזמן המרבי לפעילות המשתמש עד שהמכשיר יינעל. זה מגביל את האורך שהמשתמש יכול להגדיר.\nערך 0 אומר שאין הגבלה.</string>
	<string name="info_security_log">אם בעל מכשיר משתמש בפונקציה זו, כל המשתמשים צריכים להיות משויכים.</string>
	<string name="info_short_support_message">זה יוצג למשתמש במסכי הגדרות שבהם הפונקציונליות הושבתה על ידי המנהל. אם ההודעה ארוכה מ-200 תווים היא עשויה להיקטע</string>
	<string name="info_start_lock_task_mode">אם תאפשר הודעות בתכונות נעילה של משימות, OwnDroid יציג הודעה כאשר מצב משימות הנעילה יתחיל בהצלחה. אתה יכול לצאת ממצב משימות נעילה על ידי לחיצה על התראה זו.</string>
	<string name="info_suspend_app">חבילה מושעית לא תוכל להתחיל בפעילויות. ההתראות שלו יהיו מוסתרות, הוא לא יופיע בפעילויות האחרונות, לא יוכל להציג טוסטים או דיאלוגים או לצלצל במכשיר.\nלא ניתן להשעות אפליקציות מסוימות, כגון מנהלי מכשיר, המפעיל הפעיל וחייגן ברירת המחדל.</string>
	<string name="info_transfer_ownership">משנה את מנהל המערכת הנוכחי למנהל אחר. כל המדיניות ממנהל המערכת הנוכחי מועברת למנהל המערכת החדש.</string>
	<string name="info_unique_device_attestation">כן אם המימוש של StrongBox Keymaster במכשיר סופק עם אישור אישור בודד והוא יכול לחתום על רשומות אישור באמצעותו (רק Keymaster עם רמת אבטחה StrongBox יכול להשתמש באישור אישור בודד).</string>
	<string name="info_wipe_data_in_managed_user">כל הנתונים של המשתמש הזה יימחקו, אבל המשתמש הזה לא יוסר.</string>
